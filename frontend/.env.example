# Leave this unset for local development — Vite's dev server proxies /api
# requests to http://localhost:3001 automatically (see vite.config.js).
#
# For a production build where the frontend and backend are on different
# hosts (e.g. frontend on Vercel, backend on Render), set this to your
# deployed backend's URL before running `npm run build`:
# VITE_API_URL=https://bookflow-api.onrender.com
VITE_API_URL=
