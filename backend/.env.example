# Copy this file to .env and fill in real values before running the server.

# Local dev (matches docker-compose.yml in the repo root):
DATABASE_URL=postgres://bookflow:bookflow@localhost:5432/bookflow

# Set to "true" only when connecting to a managed Postgres that requires SSL
# with a self-signed cert (this is the case for Render's free Postgres).
PGSSL=false

# Any long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Port the API listens on
PORT=3001

# Where the frontend is served from, for CORS
CORS_ORIGIN=http://localhost:5173
