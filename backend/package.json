{
  "name": "ticket-booking-backend",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "pretest": "cross-env NODE_ENV=test JWT_SECRET=test-secret DATABASE_URL=postgres://bookflow:bookflow@localhost:5432/bookflow_test node scripts/migrate.js",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-secret DATABASE_URL=postgres://bookflow:bookflow@localhost:5432/bookflow_test node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "supertest": "^7.0.0"
  }
}
